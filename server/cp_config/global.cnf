[global]

server.socket_host: "0.0.0.0"
tools.gzip.on: True
tools.gzip.mime_types = ['text/html','application/json']
tools.gzip.priority = 80

thread_pool_max: 16
accepted_queue_size: 256

tools.sessions.on: True
tools.sessions.timeout: 10080
tools.sessions.clean_freq: 60
tools.sessions.storage_class = cherrypy.lib.sessions.FileSession
tools.sessions.storage_path = "/tmp/"

# request.body.part_class: server_tools.CustomPart

